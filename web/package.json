{
  "name": "summon-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "worker": "wrangler dev --port 8787",
    "og": "tsx scripts/og.mts",
    "deploy": "vite build && tsx scripts/og.mts && wrangler deploy",
    "test:worker": "tsx worker/worker.test.ts",
    "telegram": "tsx scripts/telegram.mts"
  },
  "dependencies": {
    "@base-org/account": "^2.6.0",
    "ox": "0.14.33",
    "viem": "2.55.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "puppeteer": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "wrangler": "^3.90.0"
  }
}
